# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and is only ever
# read server-side (Next.js Server Actions). Do NOT prefix it with NEXT_PUBLIC_ and
# do NOT commit real values in this file — set them in .env.local (gitignored) for
# local dev, and in your Vercel project's Environment Variables for deployment.
